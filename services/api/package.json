{
  "name": "@receipt-box/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./handlers/api": "./src/handlers/api.ts",
    "./handlers/process": "./src/handlers/process.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/local/server.ts",
    "start": "tsx src/local/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "eval:make": "tsx eval/make-receipts.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@aws-lambda-powertools/tracer": "^2.35.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-textract": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.1",
    "hono": "^4.13.12",
    "tesseract.js": "^7.0.0"
  }
}
